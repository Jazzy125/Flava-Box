# Local development database. Supply your own production connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Set to the owner-approved HTTPS origin before publishing.
SITE_URL=http://localhost:3000
# Optional: confirmed business WhatsApp destination, international digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional owner email notifications. Keep these values server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OWNER_EMAIL=
